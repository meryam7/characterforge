# Copy to .env and edit. Paths below are relative to the backend/ folder.

# development | production  (production requires SECRET_KEY and hides /docs)
ENVIRONMENT=development

# Local quick start (no cloud needed):
DATABASE_URL=sqlite:///./charaforge.db
# Online PostgreSQL (Neon / Supabase) - paste the connection string instead:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# true  = fake fast images, runs on any laptop
# false = real Stable Diffusion + CLIP + SAM2 (needs a GPU, see docs/AI_PIPELINE.md)
MOCK_AI=true
DEVICE=auto

# Login tokens are signed with this. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me
TOKEN_DAYS=30
# Comma-separated emails that may remove any post from the community gallery
ADMIN_EMAILS=

CORS_ORIGINS=http://localhost:5173

# Storage: local disk (dev) or s3 (Cloudflare R2 in production)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=charaforge
# S3_REGION=auto
