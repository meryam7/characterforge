{
  "name": "characterforge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --port 8788",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "typecheck": "tsc -p server && tsc -p frontend",
    "db:migrate:local": "wrangler d1 migrations apply characterforge --local",
    "db:migrate:remote": "wrangler d1 migrations apply characterforge --remote",
    "deploy": "npm run build && wrangler pages deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "5.6",
    "wrangler": "^4.158.0"
  }
}
